# Local Edge Function secrets only. Do not put these values in the Vite .env file or Vercel.
# For production at med-id-zk.vercel.app, use MEDID_RP_ID=med-id-zk.vercel.app and
# MEDID_ORIGIN=https://med-id-zk.vercel.app in Supabase Edge Function secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MEDID_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
MEDID_RP_ID=localhost
MEDID_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (set as Supabase Edge Function secrets, not Vercel variables)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=medid_emergency_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v27.0
